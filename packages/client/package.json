{
  "name": "@melorx/client",
  "version": "0.3.0-rc.1",
  "description": "Typed HTTP client for the melorx drug-drug interaction API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruhwa-innovation-labs/melorx",
    "directory": "packages/client"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo 'no linter yet'"
  },
  "devDependencies": {
    "@melorx/core": "workspace:*",
    "@types/node": "^26.6.2",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "drug-interaction",
    "ddi",
    "melorx",
    "rxnorm",
    "pharmacology",
    "healthcare",
    "open-source"
  ]
}
